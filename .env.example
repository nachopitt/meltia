# =============================================================================
# MELTIA ENVIRONMENT CONFIGURATION
# =============================================================================
APP_NAME=Meltia
APP_ENV=development
NODE_ENV=development

# Which Docker Compose files to merge so you can just run `docker compose up -d`.
# Local development:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# Production server:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Host user / group mapping for Docker container permission matching.
# Defaults to 1000:1000. On Linux host: HOST_UID=$(id -u) HOST_GID=$(id -g)
HOST_UID=1000
HOST_GID=1000

# Service Ports (Host bindings in development)
WEB_PORT=8080
BACKEND_PORT=9000
VITE_PORT=5173
DB_PORT=5432
REDIS_PORT=6379

# PostgreSQL Configuration
DB_HOST=db
DB_PORT_INTERNAL=5432
DB_DATABASE=meltia
DB_USERNAME=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@db:5432/meltia

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT_INTERNAL=6379
REDIS_URL=redis://redis:6379

# Medusa Backend & Security Secrets
MEDUSA_BACKEND_URL=http://localhost:9000
JWT_SECRET=meltia_super_secret_jwt_key_at_least_32_chars_long_12345
COOKIE_SECRET=meltia_super_secret_cookie_key_at_least_32_chars_long_12345

# CORS Configuration
STORE_CORS=http://localhost:5173,http://localhost:8080
ADMIN_CORS=http://localhost:9000,http://localhost:5173,http://localhost:8080
AUTH_CORS=http://localhost:9000,http://localhost:5173,http://localhost:8080

# Storefront Configuration
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_e948efee71591f079be63002159c43bc8a560fdc738a3d0afa0cb3b3021d9361
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:8080

# Production Image Registry (used in docker-compose.prod.yml)
CONTAINER_REGISTRY=ghcr.io/nachopitt
IMAGE_TAG=latest
