{
  "name": "meltia",
  "private": false,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:unit": "npm run --prefix apps/backend test:unit",
    "test:integration:http": "npm run --prefix apps/backend test:integration:http",
    "test:integration:modules": "npm run --prefix apps/backend test:integration:modules",
    "seed": "turbo seed --filter=@dtc/backend",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "dev:backend": "turbo dev --filter=@dtc/backend",
    "dev:storefront": "turbo dev --filter=@dtc/storefront",
    "build:backend": "turbo build --filter=@dtc/backend",
    "build:storefront": "turbo build --filter=@dtc/storefront",
    "i18n:extract": "node scripts/extract-t-keys.mjs",
    "i18n:fix": "node scripts/extract-t-keys.mjs --fix",
    "i18n:prune": "node scripts/extract-t-keys.mjs --fix --prune",
    "i18n:check": "node scripts/extract-t-keys.mjs --check"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14",
    "ajv": "^8.13.0"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  }
}